# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=logs

# Ingester
WIKIMEDIA_SSE_URL=https://stream.wikimedia.org/v2/stream/recentchange
REDIS_STREAM_KEY=logs:raw
STREAM_MAX_LEN=10000
BACKPRESSURE_SLEEP_MS=100
HEALTH_LOG_INTERVAL_SEC=30

# Processor
CONSUMER_GROUP=processors
CONSUMER_NAME=processor-1
BATCH_SIZE=50
EMBED_BATCH_SIZE=32
DEDUP_SET_KEY=seen:templates
VECTOR_CACHE_KEY=cache:vectors

# API
API_HOST=0.0.0.0
API_PORT=8000
RRF_K=60
EMBEDDING_MODEL=all-MiniLM-L6-v2
SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions
